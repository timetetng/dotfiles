{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "arch_small",
    "padding": {
      "right": 4,
      "top": 2,
      "left": 2
    },
    "color": {
      "1": "#95D5B2",
      "2": "#40916C"
    }
  },
  "display": {
    "separator": " │ ",
    "color": {
      "keys": "#74C69D",
      "title": "#95D5B2",
      "output": "#D8F3DC",
      "separator": "#74C69D" // 与 keys 同色，左右竖线颜色才统一
    },
    "size": {
      "binaryPrefix": "si",
      "ndigits": 2
    },
    "key": {
      "width": 17 // key 11 格 + 分隔符 3 格 = 14，余下 3 格空白后接 value
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "╭───────────╮", // 13 格 = key 11 格 + 2，右边角正好压在分隔符的 │ 上
      "outputColor": "#74C69D" // 横线跟左右竖线同色
    },
    // 用户名
    {
      "type": "command",
      "key": "│  user   ",
      "text": "whoami"
    },
    // 运行时间
    {
      "type": "uptime",
      "key": "│ 󰔚 uptime "
    },
    // 发行版
    {
      "type": "os",
      "key": "│  distro "
    },
    // 内核（原 ⚙ 不在终端字体里，换成 nf-md-linux）
    {
      "type": "kernel",
      "key": "│ 󰌽 kernel ",
      "format": "{release}"
    },
    // 窗口管理器
    {
      "type": "wm",
      "key": "│  wm     "
    },
    // 终端
    {
      "type": "command",
      "key": "│  term   ",
      "text": "echo $TERM"
    },
    // Shell
    {
      "type": "shell",
      "key": "│  shell  "
    },
    // 编辑器
    {
      "type": "editor",
      "key": "│  editor "
    },
    // 磁盘
    {
      "type": "disk",
      "key": "│ 󰋊 disk   ",
      "folders": "/",
      "format": "{size-used} / {size-total}"
    },
    // 内存
    {
      "type": "memory",
      "key": "│ 󰍛 memory ",
      "format": "{used} / {total} ({percentage})"
    },
    // 中间分隔线
    {
      "type": "custom",
      "format": "├───────────┤",
      "outputColor": "#74C69D"
    },
    // 颜色圆点
    {
      "type": "colors",
      "key": "│  colors ",
      "symbol": "circle"
    },
    {
      "type": "custom",
      "format": "╰───────────╯",
      "outputColor": "#74C69D"
    }
  ]
}
