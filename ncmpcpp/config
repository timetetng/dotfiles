##### 基础连接设置 #####
mpd_host = "localhost"
mpd_port = "6600"
mpd_music_dir = "/home/xingjian/Music"
# 确保这个目录存在: mkdir -p /home/xingjian/.ncmpcpp/lyrics
ncmpcpp_directory = "/home/xingjian/.ncmpcpp"
lyrics_directory = "/home/xingjian/.ncmpcpp/lyrics"
mpd_connection_timeout = "5"
mpd_crossfade_time = "5"

##### 界面布局 #####
user_interface = "alternative"
search_engine_display_mode = "columns"
playlist_display_mode = "columns"
browser_display_mode = "columns"
playlist_disable_highlight_delay = "0"
autocenter_mode = "yes"
centered_cursor = "yes"
ignore_leading_the = "yes"
default_place_to_search_in = "database"

##### 颜色与样式 #####
colors_enabled = "yes"
main_window_color = "white"
header_window_color = "cyan"
volume_color = "red"
progressbar_color = "cyan"
statusbar_color = "white"
active_window_border = "blue"

##### 歌曲显示格式 #####
# 这里的格式会让你的列表看起来非常整齐
song_columns_list_format = "(10)[blue]{l} (30)[green]{a} (30)[magenta]{b} (50)[yellow]{t}"
song_list_format = "{3%n │ 9}{7%a - 9}{5%t9}|{8%f9}R{6 │ %b9}{3 │ %l9}"
song_status_format = " 2%a4⟫3⟫8%t 4⟫3⟫ $5%b "
alternative_header_first_line_format = "0aqqu/a {7%a - 9}{5%t9}|{8%f9}0atqq/a9"
alternative_header_second_line_format = "{{6%b9}{ [6%y9]}}|{%D}"

##### 可视化频谱 (Visualizer) #####
visualizer_data_source = "/tmp/mpd.fifo"
visualizer_output_name = "my_fifo"
visualizer_type = "spectrum"
# 这里改为 no，解决你说的“上下两行”问题
visualizer_in_stereo = "no"
# 使用你喜欢的实心符号
visualizer_look = "●▋"
# 让频谱变色（渐变效果）
visualizer_color = "cyan,blue,magenta,red"

##### 歌词设置 #####
follow_now_playing_lyrics = "yes"
lyrics_fetchers = "musixmatch, genius, azlyrics, sing365"

##### 交互与导航 #####
cyclic_scrolling = "yes"
header_text_scrolling = "yes"
jump_to_now_playing_song_at_start = "yes"
lines_scrolled = "2"
incremental_seeking = "yes"
seek_time = "1"
regular_expressions = "extended"

##### 状态栏与工具栏 #####
header_visibility = "yes"
statusbar_visibility = "yes"
titles_visibility = "yes"
progressbar_look = "=>-"
progressbar_elapsed_color = "white"
display_bitrate = "yes"
now_playing_prefix = "> "
selected_item_prefix = "* "
discard_colors_if_item_is_selected = "no"
